# Copy to keystore.properties (git-ignored) and fill in to sign release builds.
# Generate a keystore first, e.g.:
#   keytool -genkeypair -v -keystore vibeview-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias vibeview
#
# storeFile may be absolute or relative to the repository root.
storeFile=vibeview-release.jks
storePassword=CHANGE_ME
keyAlias=vibeview
keyPassword=CHANGE_ME
